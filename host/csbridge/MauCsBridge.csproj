<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MauCsBridge</AssemblyName>
    <RootNamespace>MauCsBridge</RootNamespace>
    <!-- 引用源 = mauout 运行区（只读引用，不触发 mau 仓库构建）。
         失败面：MSB3277 版本冲突为已知噪音（Roslyn 4.11 与 .NET 10 平台引用并存）。 -->
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Mau.Development">
      <HintPath>D:\Mau\MauOut\Mau.Development.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Mau.Runtime">
      <HintPath>D:\Mau\MauOut\Mau.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Mau.Contracts">
      <HintPath>D:\Mau\MauOut\Mau.Contracts.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Mau.Translator">
      <HintPath>D:\Mau\MauOut\Mau.Translator.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Roslyn 编译期引用（只读引用 mauout；Private=false 不复制——运行时用下方 None 复制件） -->
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>D:\Mau\MauOut\Microsoft.CodeAnalysis.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>D:\Mau\MauOut\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.Workspaces">
      <HintPath>D:\Mau\MauOut\Microsoft.CodeAnalysis.Workspaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Workspaces">
      <HintPath>D:\Mau\MauOut\Microsoft.CodeAnalysis.CSharp.Workspaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Composition.Runtime">
      <HintPath>D:\Mau\MauOut\System.Composition.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Composition.AttributedModel">
      <HintPath>D:\Mau\MauOut\System.Composition.AttributedModel.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Composition.TypedParts">
      <HintPath>D:\Mau\MauOut\System.Composition.TypedParts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Composition.Hosting">
      <HintPath>D:\Mau\MauOut\System.Composition.Hosting.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Composition.Convention">
      <HintPath>D:\Mau\MauOut\System.Composition.Convention.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 运行时依赖：Roslyn / MSBuild / 组合容器 / build host——按文件复制到输出目录 -->
  <ItemGroup>
    <None Include="D:\Mau\MauOut\Microsoft.*.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="D:\Mau\MauOut\System.Composition.*.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="D:\Mau\MauOut\System.Reflection.MetadataLoadContext.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="D:\Mau\MauOut\Newtonsoft.Json.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="D:\Mau\MauOut\BuildHost-netcore\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="BuildHost-netcore" />
  </ItemGroup>

</Project>
