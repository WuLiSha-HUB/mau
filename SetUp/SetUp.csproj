<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SetUp</AssemblyName>
    <RootNamespace>SetUp</RootNamespace>
    <Version>0.6.0</Version>
    <!-- 单文件发布——框架依赖（需 .NET 10 runtime；runtime 缺失时 apphost 自带友好提示
         跟随 Git 发布：dotnet publish 后复制 SetUp.exe 到仓库根
         P4（design-ch4-platform §七）——去 WinForms GUI：单 TFM net10.0，无参打印帮助 -->
    <!-- P4 修正（2026-11-14 实测）：net10.0 下 PublishSingleFile 必须显式 RuntimeIdentifier——无 RID 时 CSC 报
         CS5001（程序不包含入口点）。故改为「带 RID 才单文件」；发布命令：
         dotnet publish SetUp/SetUp.csproj -c Debug -r win-x64 （框架依赖） -o 仓库根
         Linux 侧同形传 -r linux-x64——RID 由调用方给，不在工程内硬编码平台 / 架构。 -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- 平台服务面（P4）——可执行名 / 路径默认值的单一出口（design-ch4-platform §六） -->
  <ItemGroup>
    <ProjectReference Include="..\CatHome4\CatHome4.Platform\CatHome4.Platform.csproj" />
  </ItemGroup>

  <!-- 源码快照嵌入（A270）——自举代际自检的判据面：exe 内嵌 SetUp/ 源码内容，运行期与磁盘逐文件 SHA256 比对，
       不再依赖写盘时刻（git 拉取同批落盘 → mtime 先后无保证，旧的 exe-vs-源码 mtime 判据每次都可能误报）。
       排除 bin / obj 构建产物（与运行期 IsBuildArtifactPath 同构）；LogicalName 前缀 src/ 为运行期识别标记。 -->
  <ItemGroup>
    <EmbeddedResource Include="**/*.cs" Exclude="obj/**;bin/**" LogicalName="src/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
