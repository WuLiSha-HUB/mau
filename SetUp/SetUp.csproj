<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SetUp</AssemblyName>
    <RootNamespace>SetUp</RootNamespace>
    <Version>0.5.9</Version>
    <!-- 单文件发布——框架依赖（需 .NET 10 runtime；runtime 缺失时 apphost 自带友好提示
         跟随 Git 发布：dotnet publish 后复制 SetUp.exe 到仓库根 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- 源码快照嵌入（A270）——自举代际自检的判据面：exe 内嵌 SetUp/ 源码内容，运行期与磁盘逐文件 SHA256 比对，
       不再依赖写盘时刻（git 拉取同批落盘 → mtime 先后无保证，旧的 exe-vs-源码 mtime 判据每次都可能误报）。
       排除 bin / obj 构建产物（与运行期 IsBuildArtifactPath 同构）；LogicalName 前缀 src/ 为运行期识别标记。 -->
  <ItemGroup>
    <EmbeddedResource Include="**/*.cs" Exclude="obj/**;bin/**" LogicalName="src/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
