// cs_cat.mau —— CsCat 语料（CH4 R0.2 工具组 Flow 化——CS 编码工具域独立 Flow，原 DevCat 分部拆分）
// 角色：工具组 Flow——认领 TOOL 域 cs-* 13 工具（check/build/test/list/read/find_ref/find/patch/member/comment/dead/comment_check/format）
// 单级 OA 单：Dog Post → 本 Flow 13 线认领执行 → complete_str 回执
// 载荷协议：officeName = 工具名；载荷 key "args" = 整包工具参数 JSON
// 无值分支：每工具一条认领线，工具名写死在候选列表（信号即解析结果——分支拓扑靠多传感器）
// 数据面：@ckOffice 等私有盒（FlowId 隔离）；args/result 经 OA 载荷传输（get_str/complete_str）
// 线程模型（A48 后台化）：收单/读参/回执主线程同步；执行步 [t=1200, par] 后台线程执行（主线程零阻塞）
//   —— 在途期间状态停在 Ready（不接新单，新单留 OA 队列）+ Busy 门防重入（线级唯一在途槽 = 结构性不可并发的锁）
//   —— 回投由主线程 Drain 应用（代际守卫：超时作废后迟到的结果按代际丢弃）
//   —— 超时 1200 帧（120s）：后台未回投则主动按失败结算（T_*Abort 回执 ERR 可见）
// 观测：trace 埋点生成器内建 + OA 机制专属 Log（帧号回溯）+ trace.timeout / trace.late_discard
// 变更（2026-09-14 A48）：exec 导线 par 化——self.desc 挪至 args 导线（par 导线单动作约束）；执行脱离主线程

// ── 状态机（12 线——每线独立生命周期）──
§ 'S_Check' = { 'Init', 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Build' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_List' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_CsRead' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_FindRef' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Find' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Patch' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Member' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Comment' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Dead' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_CommentCheck' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Format' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Test' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }

// T_Init：启动初始化自述——Init → Idle 首帧写"空闲待命"（R0.2 外观层：启动即有自述横幅）
§ 'T_Init' : 'S_Check' = 'Init' → 'self.desc'["空闲待命", "", ""] | 'S_Check' = 'Idle' | 'S_Check' = 'Idle'

// ── 主动传感器壳——12 线各自探测（officeName = 完整工具名）──
§ 'P_CheckOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-check"] > @ckOpen
§ 'P_BuildOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-build"] > @buOpen
§ 'P_ListOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-list"] > @liOpen
§ 'P_CsReadOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-read"] > @csOpen
§ 'P_FindRefOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-find_ref"] > @frOpen
§ 'P_FindOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-find"] > @fiOpen
§ 'P_PatchOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-patch"] > @ptOpen
§ 'P_MemberOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-member"] > @mbOpen
§ 'P_CommentOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-comment"] > @cmOpen
§ 'P_DeadOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-dead"] > @ddOpen
§ 'P_CommentCheckOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-comment_check"] > @ccOpen
§ 'P_FormatOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-format"] > @fmOpen
§ 'P_TestOpen' ↻ [1]: 'oa.is_open'["TOOL", "cs-test"] > @ttOpen

// ══════════════ cs-check 线 ══════════════
§ 'T_CheckClaim' : @ckOpen & 'S_Check' = 'Idle' → 'oa.claim_next_simple'["TOOL", "cs-check"] > @ckOffice | 'S_Check' = 'Claimed' | 'S_Check' = 'Idle'
§ 'T_CheckArgs' : 'S_Check' = 'Claimed' → 'oa.get_str'[@ckOffice, "args"] > @ckArgs | 'self.desc'["cs-check 执行中", "", ""] | 'S_Check' = 'Ready' | 'S_Check' = 'Failed'
§ 'T_CheckExec' [t=1200, par] : 'S_Check' = 'Ready' → 'csharp.bridge'["check", @ckArgs] > @ckRes | 'S_Check' = 'Done' | 'S_Check' = 'Failed'
§ 'T_CheckReply' : 'S_Check' = 'Done' → 'oa.complete_str'[@ckOffice, @ckRes] | 'self.desc'["空闲待命", "", ""] | 'S_Check' = 'Idle' | 'S_Check' = 'Idle'
§ 'T_CheckAbort' : 'S_Check' = 'Failed' → 'oa.complete_str'[@ckOffice, @ckRes] | 'S_Check' = 'Idle' | 'S_Check' = 'Idle'

// ══════════════ cs-build 线 ══════════════
§ 'T_BuildClaim' : @buOpen & 'S_Build' = 'Idle' → 'oa.claim_next_simple'["TOOL", "cs-build"] > @buOffice | 'S_Build' = 'Claimed' | 'S_Build' = 'Idle'
§ 'T_BuildArgs' : 'S_Build' = 'Claimed' → 'oa.get_str'[@buOffice, "args"] > @buArgs | 'self.desc'["cs-build 执行中", "", ""] | 'S_Build' = 'Ready' | 'S_Build' = 'Failed'
§ 'T_BuildExec' [t=1200, par] : 'S_Build' = 'Ready' → 'csharp.bridge'["build", @buArgs] > @buRes | 'S_Build' = 'Done' | 'S_Build' = 'Failed'
§ 'T_BuildReply' : 'S_Build' = 'Done' → 'oa.complete_str'[@buOffice, @buRes] | 'self.desc'["空闲待命", "", ""] | 'S_Build' = 'Idle' | 'S_Build' = 'Idle'
§ 'T_BuildAbort' : 'S_Build' = 'Failed' → 'oa.complete_str'[@buOffice, @buRes] | 'S_Build' = 'Idle' | 'S_Build' = 'Idle'

