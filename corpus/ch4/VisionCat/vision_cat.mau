// vision_cat.mau —— VisionCat 语料（CH4 R2.2 工具组——VISION 视觉识别域独立 Flow）
// 角色：工具组 Flow——认领 TOOL 域 image-analyze 1 工具（图像识别）
// 单级 OA 单：Dog（宿主 ToolOrderDog 实体）Post → 本 Flow 1 线认领执行 → complete_str 回执
// 载荷协议：officeName = 工具名；载荷 key "args" = 整包工具参数 JSON
// 无值分支：工具名写死在候选列表（信号即解析结果——分支拓扑靠多传感器）
// 数据面：@vrOffice 等私有盒（FlowId 隔离）；args/result 经 OA 载荷传输（get_str/complete_str）
// 线程模型（A48 后台化）：收单/读参/回执主线程同步；执行步 [t=1200, par] 后台线程执行（主线程零阻塞）
//   —— 在途期间状态停在 Ready（不接新单，新单留 OA 队列）+ Busy 门防重入（线级唯一在途槽 = 结构性不可并发的锁）
//   —— 回投由主线程 Drain 应用（代际守卫：超时作废后迟到的结果按代际丢弃）；超时 1200 帧（120s）
//   —— 视觉 API 网络等待原为同步阻塞主线程——par 化后主循环不中断
// 观测：trace 埋点生成器内建 + OA 机制专属 Log（帧号回溯）+ trace.timeout / trace.late_discard
// 变更（2026-09-14 A48）：exec 导线 par 化——self.desc 挪至 args 导线（par 导线单动作约束）

// ── 状态机（1 线——独立生命周期）──
§ 'S_Vision' = { 'Init', 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }

// T_Init：启动初始化自述——Init → Idle 首帧写"空闲待命"（R0.2 外观层：启动即有自述横幅）
§ 'T_Init' : 'S_Vision' = 'Init' → 'self.desc'["空闲待命", "", ""] | 'S_Vision' = 'Idle' | 'S_Vision' = 'Idle'

// ── 主动传感器壳——1 线探测（纯只读判断积木 → bool 落盒）──
§ 'P_VisionOpen' ↻ [1]: 'oa.is_open'["TOOL", "image-analyze"] > @vrOpen

// ══════════════ image-analyze 线 ══════════════

// T_VisionClaim：探测真 + Idle → 原子接单（竞态失败回 Idle 重试）
§ 'T_VisionClaim' : @vrOpen & 'S_Vision' = 'Idle' → 'oa.claim_next_simple'["TOOL", "image-analyze"] > @vrOffice | 'S_Vision' = 'Claimed' | 'S_Vision' = 'Idle'

// T_VisionArgs：读载荷 args（整包工具参数 JSON）+ 执行中自述（par 导线单动作约束——desc 前移）
§ 'T_VisionArgs' : 'S_Vision' = 'Claimed' → 'oa.get_str'[@vrOffice, "args"] > @vrArgs | 'self.desc'["image-analyze 执行中", "", ""] | 'S_Vision' = 'Ready' | 'S_Vision' = 'Failed'

// T_VisionExec：执行积木（识图——图片读取与格式化在工具内部；失败侧 ERR 文本也在 @vrRes）——后台执行
§ 'T_VisionExec' [t=1200, par] : 'S_Vision' = 'Ready' → 'vision.analyze'[@vrArgs] > @vrRes | 'S_Vision' = 'Done' | 'S_Vision' = 'Failed'

// T_VisionReply：成功回执（result=分析结果文本）
§ 'T_VisionReply' : 'S_Vision' = 'Done' → 'oa.complete_str'[@vrOffice, @vrRes] | 'self.desc'["空闲待命", "", ""] | 'S_Vision' = 'Idle' | 'S_Vision' = 'Idle'

// T_VisionAbort：失败回执（@vrRes 含 ERR| 文本——失败侧也回执，Dog 可见失败原因）
§ 'T_VisionAbort' : 'S_Vision' = 'Failed' → 'oa.complete_str'[@vrOffice, @vrRes] | 'S_Vision' = 'Idle' | 'S_Vision' = 'Idle'

// ══════════════ image-inject 线（A105 图片真实插入主干） ══════════════

// 语义（design-ch4-chat-images §八）：本线只做 OA 闭环 + 参数回显；图片由宿主批后段合并注入一条 user 消息（引用随消息落盘、请求构造时展开为内容块）。
// 门禁：仅 timeback 作用域内可用——在宿主工具登记段拦截（域外 ERR|TIMEBACK_REQUIRED），本线不重复判定。
// 状态机（本线从 Idle 起——不设 Init 自述转移，避免与 S_Vision 首帧 desc 竞争）
§ 'S_Inject' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }

// 探测：本工具工单开（纯只读判断积木 → bool 落盒）
§ 'P_InjectOpen' ↻ [1]: 'oa.is_open'["TOOL", "image-inject"] > @viOpen

// T_InjectClaim：探测真 + Idle → 原子接单（竞态失败回 Idle 重试）
§ 'T_InjectClaim' : @viOpen & 'S_Inject' = 'Idle' → 'oa.claim_next_simple'["TOOL", "image-inject"] > @viOffice | 'S_Inject' = 'Claimed' | 'S_Inject' = 'Idle'

// T_InjectArgs：读载荷 args（整包工具参数 JSON——参数仅 path）
§ 'T_InjectArgs' : 'S_Inject' = 'Claimed' → 'oa.get_str'[@viOffice, "args"] > @viArgs | 'self.desc'["image-inject 登记中", "", ""] | 'S_Inject' = 'Ready' | 'S_Inject' = 'Failed'

// T_InjectExec：执行积木（参数面校验 + 登记回执；真图注入由宿主批后段执行——积木不触前文）
§ 'T_InjectExec' : 'S_Inject' = 'Ready' → 'image.inject'[@viArgs] > @viRes | 'S_Inject' = 'Done' | 'S_Inject' = 'Failed'

// T_InjectReply：成功回执（结构化头：ok/tool/path）
§ 'T_InjectReply' : 'S_Inject' = 'Done' → 'oa.complete_str'[@viOffice, @viRes] | 'self.desc'["空闲待命", "", ""] | 'S_Inject' = 'Idle' | 'S_Inject' = 'Idle'

// T_InjectAbort：失败回执（参数面错误文本——ERR|BAD_ARGS 等）
§ 'T_InjectAbort' : 'S_Inject' = 'Failed' → 'oa.complete_str'[@viOffice, @viRes] | 'S_Inject' = 'Idle' | 'S_Inject' = 'Idle'
