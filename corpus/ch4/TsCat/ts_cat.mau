§ 'P_FormatOpen' ↻ [1]: 'oa.is_open'["TOOL", "ts-format"] > @fmOpen
§ 'T_FormatClaim' : @fmOpen & 'S_Format' = 'Idle' → 'oa.claim_next_simple'["TOOL", "ts-format"] > @fmOffice | 'S_Format' = 'Claimed' | 'S_Format' = 'Idle'
§ 'T_FormatArgs' : 'S_Format' = 'Claimed' → 'oa.get_str'[@fmOffice, "args"] > @fmArgs | 'self.desc'["ts-format 规整中", "", ""] | 'S_Format' = 'Ready' | 'S_Format' = 'Failed'
§ 'T_FormatExec' [t=1200, par] : 'S_Format' = 'Ready' → 'ts.format'[@fmArgs] > @fmRes | 'S_Format' = 'Done' | 'S_Format' = 'Failed'
§ 'T_FormatReply' : 'S_Format' = 'Done' → 'oa.complete_str'[@fmOffice, @fmRes] | 'self.desc'["空闲待命", "", ""] | 'S_Format' = 'Idle' | 'S_Format' = 'Idle'
§ 'T_FormatAbort' : 'S_Format' = 'Failed' → 'oa.complete_str'[@fmOffice, @fmRes] | 'S_Format' = 'Idle' | 'S_Format' = 'Idle'
