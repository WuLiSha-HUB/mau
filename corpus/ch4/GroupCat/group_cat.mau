// group_cat.mau —— GroupCat 语料（群组工具组——group-* 八件独立 Flow）
// 角色：工具组 Flow——认领 TOOL 域 group-info / group-inbox / group-post / group-delegate / group-newsession / group-catinfo / group-catcfg-get / group-catcfg-set
// 权限：读面（info / inbox / post / catinfo / catcfg-get）须组成员，可查组内任一成员；写面（delegate / newsession / catcfg-set）另需组管理员 group.json adminKeys——校验在宿主实现（IGroupService）
// 受限工具名单（硬编码，莎 2026-11-09）：group-catcfg-set / group-newsession 不可经任何工具写入 toolNames（公共层 ValidateToolNames 拦，只拦新增）
// 命名（2026-11-05 莎裁 β）：group-post 只写组流不唤醒、无 @ 目标参数；group-delegate 才派活并唤醒目标猫（积木名 group.say / group.send 为内部实现名，不改）
// 单级 OA 单：Dog（宿主 ToolOrderDog 实体）Post → 本 Flow 5 线认领执行 → complete_str 回执
// 载荷协议：officeName = 工具名（连字符分隔）；载荷 key "args" = 整包工具参数 JSON（含宿主注入保留键 catId）
// 线程模型：全部主线程同步——投递触碰会话面（ThreadGuard 主线程守卫），不得 par 化
// 服务面：积木经 DataBox.TryResolve<IGroupService>（宿主 S1 段绑定；未注入即 ERR|GROUP_NO_SERVICE）

// ── 状态机（5 线——每线独立生命周期）──
§ 'S_Info' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Inbox' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Post' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Delegate' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_New' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_CatInfo' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_CfgGet' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_CfgSet' = { 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }

// ── 主动传感器壳——5 线各自探测（纯只读判断积木 → bool 落盒）──
§ 'P_InfoOpen' ↻ [1]: 'oa.is_open'["TOOL", "group-info"] > @giOpen
§ 'P_InboxOpen' ↻ [1]: 'oa.is_open'["TOOL", "group-inbox"] > @gxOpen
§ 'P_PostOpen' ↻ [1]: 'oa.is_open'["TOOL", "group-post"] > @gsOpen
§ 'P_DelegateOpen' ↻ [1]: 'oa.is_open'["TOOL", "group-delegate"] > @gdOpen
§ 'P_NewOpen' ↻ [1]: 'oa.is_open'["TOOL", "group-newsession"] > @gnOpen
§ 'P_CatInfoOpen' ↻ [1]: 'oa.is_open'["TOOL", "group-catinfo"] > @ciOpen
§ 'P_CfgGetOpen' ↻ [1]: 'oa.is_open'["TOOL", "group-catcfg-get"] > @cgOpen
§ 'P_CfgSetOpen' ↻ [1]: 'oa.is_open'["TOOL", "group-catcfg-set"] > @cwOpen

// ══════════════ group-info 线 ══════════════
§ 'T_InfoClaim' : @giOpen & 'S_Info' = 'Idle' → 'oa.claim_next_simple'["TOOL", "group-info"] > @giOffice | 'S_Info' = 'Claimed' | 'S_Info' = 'Idle'
§ 'T_InfoArgs' : 'S_Info' = 'Claimed' → 'oa.get_str'[@giOffice, "args"] > @giArgs | 'self.desc'["group-info 执行中", "", ""] | 'S_Info' = 'Ready' | 'S_Info' = 'Failed'
§ 'T_InfoExec' : 'S_Info' = 'Ready' → 'group.info'[@giArgs] > @giRes | 'S_Info' = 'Done' | 'S_Info' = 'Failed'
§ 'T_InfoReply' : 'S_Info' = 'Done' → 'oa.complete_str'[@giOffice, @giRes] | 'self.desc'["空闲待命", "", ""] | 'S_Info' = 'Idle' | 'S_Info' = 'Idle'
§ 'T_InfoAbort' : 'S_Info' = 'Failed' → 'oa.complete_str'[@giOffice, @giRes] | 'S_Info' = 'Idle' | 'S_Info' = 'Idle'

// ══════════════ group-inbox 线 ══════════════
§ 'T_InboxClaim' : @gxOpen & 'S_Inbox' = 'Idle' → 'oa.claim_next_simple'["TOOL", "group-inbox"] > @gxOffice | 'S_Inbox' = 'Claimed' | 'S_Inbox' = 'Idle'
§ 'T_InboxArgs' : 'S_Inbox' = 'Claimed' → 'oa.get_str'[@gxOffice, "args"] > @gxArgs | 'self.desc'["group-inbox 执行中", "", ""] | 'S_Inbox' = 'Ready' | 'S_Inbox' = 'Failed'
§ 'T_InboxExec' : 'S_Inbox' = 'Ready' → 'group.inbox'[@gxArgs] > @gxRes | 'S_Inbox' = 'Done' | 'S_Inbox' = 'Failed'
§ 'T_InboxReply' : 'S_Inbox' = 'Done' → 'oa.complete_str'[@gxOffice, @gxRes] | 'self.desc'["空闲待命", "", ""] | 'S_Inbox' = 'Idle' | 'S_Inbox' = 'Idle'
§ 'T_InboxAbort' : 'S_Inbox' = 'Failed' → 'oa.complete_str'[@gxOffice, @gxRes] | 'S_Inbox' = 'Idle' | 'S_Inbox' = 'Idle'

// ══════════════ group-post 线 ══════════════
§ 'T_PostClaim' : @gsOpen & 'S_Post' = 'Idle' → 'oa.claim_next_simple'["TOOL", "group-post"] > @gsOffice | 'S_Post' = 'Claimed' | 'S_Post' = 'Idle'
§ 'T_PostArgs' : 'S_Post' = 'Claimed' → 'oa.get_str'[@gsOffice, "args"] > @gsArgs | 'self.desc'["group-post 执行中", "", ""] | 'S_Post' = 'Ready' | 'S_Post' = 'Failed'
§ 'T_PostExec' : 'S_Post' = 'Ready' → 'group.say'[@gsArgs] > @gsRes | 'S_Post' = 'Done' | 'S_Post' = 'Failed'
§ 'T_PostReply' : 'S_Post' = 'Done' → 'oa.complete_str'[@gsOffice, @gsRes] | 'self.desc'["空闲待命", "", ""] | 'S_Post' = 'Idle' | 'S_Post' = 'Idle'
§ 'T_PostAbort' : 'S_Post' = 'Failed' → 'oa.complete_str'[@gsOffice, @gsRes] | 'S_Post' = 'Idle' | 'S_Post' = 'Idle'

// ══════════════ group-delegate 线（派活并唤醒：写组消息 + 投递目标猫）══════════════
§ 'T_DelegateClaim' : @gdOpen & 'S_Delegate' = 'Idle' → 'oa.claim_next_simple'["TOOL", "group-delegate"] > @gdOffice | 'S_Delegate' = 'Claimed' | 'S_Delegate' = 'Idle'
§ 'T_DelegateArgs' : 'S_Delegate' = 'Claimed' → 'oa.get_str'[@gdOffice, "args"] > @gdArgs | 'self.desc'["group-delegate 执行中", "", ""] | 'S_Delegate' = 'Ready' | 'S_Delegate' = 'Failed'
§ 'T_DelegateExec' : 'S_Delegate' = 'Ready' → 'group.send'[@gdArgs] > @gdRes | 'S_Delegate' = 'Done' | 'S_Delegate' = 'Failed'
§ 'T_DelegateReply' : 'S_Delegate' = 'Done' → 'oa.complete_str'[@gdOffice, @gdRes] | 'self.desc'["空闲待命", "", ""] | 'S_Delegate' = 'Idle' | 'S_Delegate' = 'Idle'
§ 'T_DelegateAbort' : 'S_Delegate' = 'Failed' → 'oa.complete_str'[@gdOffice, @gdRes] | 'S_Delegate' = 'Idle' | 'S_Delegate' = 'Idle'

// ══════════════ group-newsession 线（重建会话：管理员发起 + 组内留痕）══════════════
§ 'T_NewClaim' : @gnOpen & 'S_New' = 'Idle' → 'oa.claim_next_simple'["TOOL", "group-newsession"] > @gnOffice | 'S_New' = 'Claimed' | 'S_New' = 'Idle'
§ 'T_NewArgs' : 'S_New' = 'Claimed' → 'oa.get_str'[@gnOffice, "args"] > @gnArgs | 'self.desc'["group-newsession 执行中", "", ""] | 'S_New' = 'Ready' | 'S_New' = 'Failed'
§ 'T_NewExec' : 'S_New' = 'Ready' → 'group.new_session'[@gnArgs] > @gnRes | 'S_New' = 'Done' | 'S_New' = 'Failed'
§ 'T_NewReply' : 'S_New' = 'Done' → 'oa.complete_str'[@gnOffice, @gnRes] | 'self.desc'["空闲待命", "", ""] | 'S_New' = 'Idle' | 'S_New' = 'Idle'
§ 'T_NewAbort' : 'S_New' = 'Failed' → 'oa.complete_str'[@gnOffice, @gnRes] | 'S_New' = 'Idle' | 'S_New' = 'Idle'

// ══════════════ group-catinfo 线（单猫运行态统计：组成员可读任一成员）══════════════
§ 'T_CatInfoClaim' : @ciOpen & 'S_CatInfo' = 'Idle' → 'oa.claim_next_simple'["TOOL", "group-catinfo"] > @ciOffice | 'S_CatInfo' = 'Claimed' | 'S_CatInfo' = 'Idle'
§ 'T_CatInfoArgs' : 'S_CatInfo' = 'Claimed' → 'oa.get_str'[@ciOffice, "args"] > @ciArgs | 'self.desc'["group-catinfo 执行中", "", ""] | 'S_CatInfo' = 'Ready' | 'S_CatInfo' = 'Failed'
§ 'T_CatInfoExec' : 'S_CatInfo' = 'Ready' → 'group.catinfo'[@ciArgs] > @ciRes | 'S_CatInfo' = 'Done' | 'S_CatInfo' = 'Failed'
§ 'T_CatInfoReply' : 'S_CatInfo' = 'Done' → 'oa.complete_str'[@ciOffice, @ciRes] | 'self.desc'["空闲待命", "", ""] | 'S_CatInfo' = 'Idle' | 'S_CatInfo' = 'Idle'
§ 'T_CatInfoAbort' : 'S_CatInfo' = 'Failed' → 'oa.complete_str'[@ciOffice, @ciRes] | 'S_CatInfo' = 'Idle' | 'S_CatInfo' = 'Idle'

// ══════════════ group-catcfg-get 线（每猫配置读取：组成员可读任一成员）══════════════
§ 'T_CfgGetClaim' : @cgOpen & 'S_CfgGet' = 'Idle' → 'oa.claim_next_simple'["TOOL", "group-catcfg-get"] > @cgOffice | 'S_CfgGet' = 'Claimed' | 'S_CfgGet' = 'Idle'
§ 'T_CfgGetArgs' : 'S_CfgGet' = 'Claimed' → 'oa.get_str'[@cgOffice, "args"] > @cgArgs | 'self.desc'["group-catcfg-get 执行中", "", ""] | 'S_CfgGet' = 'Ready' | 'S_CfgGet' = 'Failed'
§ 'T_CfgGetExec' : 'S_CfgGet' = 'Ready' → 'group.catcfg_get'[@cgArgs] > @cgRes | 'S_CfgGet' = 'Done' | 'S_CfgGet' = 'Failed'
§ 'T_CfgGetReply' : 'S_CfgGet' = 'Done' → 'oa.complete_str'[@cgOffice, @cgRes] | 'self.desc'["空闲待命", "", ""] | 'S_CfgGet' = 'Idle' | 'S_CfgGet' = 'Idle'
§ 'T_CfgGetAbort' : 'S_CfgGet' = 'Failed' → 'oa.complete_str'[@cgOffice, @cgRes] | 'S_CfgGet' = 'Idle' | 'S_CfgGet' = 'Idle'

// ══════════════ group-catcfg-set 线（每猫配置写入：仅组管理员 + 拒改自己）══════════════
§ 'T_CfgSetClaim' : @cwOpen & 'S_CfgSet' = 'Idle' → 'oa.claim_next_simple'["TOOL", "group-catcfg-set"] > @cwOffice | 'S_CfgSet' = 'Claimed' | 'S_CfgSet' = 'Idle'
§ 'T_CfgSetArgs' : 'S_CfgSet' = 'Claimed' → 'oa.get_str'[@cwOffice, "args"] > @cwArgs | 'self.desc'["group-catcfg-set 执行中", "", ""] | 'S_CfgSet' = 'Ready' | 'S_CfgSet' = 'Failed'
§ 'T_CfgSetExec' : 'S_CfgSet' = 'Ready' → 'group.catcfg_set'[@cwArgs] > @cwRes | 'S_CfgSet' = 'Done' | 'S_CfgSet' = 'Failed'
§ 'T_CfgSetReply' : 'S_CfgSet' = 'Done' → 'oa.complete_str'[@cwOffice, @cwRes] | 'self.desc'["空闲待命", "", ""] | 'S_CfgSet' = 'Idle' | 'S_CfgSet' = 'Idle'
§ 'T_CfgSetAbort' : 'S_CfgSet' = 'Failed' → 'oa.complete_str'[@cwOffice, @cwRes] | 'S_CfgSet' = 'Idle' | 'S_CfgSet' = 'Idle'
