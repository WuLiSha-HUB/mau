// py_cat.mau —— PyCat 语料（CH4 py 工具组——BRIK-PY-001 py.run / 002 py.list / 003 py.service 积木执行面）
// 角色：工具组 Flow——认领 TOOL 域 py-run / py-list / py-service 3 工具（py 执行器面）
// 单级 OA 单：Dog（宿主 ToolOrderDog 实体）Post → 本 Flow 3 线认领执行 → complete_str 回执
// 载荷协议：officeName = 工具名（py-run / py-list / py-service）；载荷 key "args" = 整包工具参数 JSON
// 无值分支：每工具一条认领线，工具名写死在候选列表（信号即解析结果——分支拓扑靠多传感器）
// 数据面：每线 @xxxOffice/@xxxArgs/@xxxRes 私有盒（FlowId 隔离）；args/result 经 OA 载荷传输（get_str/complete_str）
// 线程模型（A48 后台化）：收单/读参/回执主线程同步；执行步 [t=1200, par] 后台线程执行（主线程零阻塞）
//   —— 在途期间状态停在 Ready（不接新单，新单留 OA 队列）+ Busy 门防重入（线级唯一在途槽 = 结构性不可并发的锁）
//   —— 回投由主线程 Drain 应用（代际守卫：超时作废后迟到的结果按代际丢弃）
//   —— 超时 1200 帧（120s）：后台未回投则主动按失败结算（T_*Abort 回执 ERR 可见）
// 服务面：py-service 只做启停查（start 等就绪握手可能数秒；stop 优雅退出）——服务调用由各业务组自有积木消费 IPyService
// 观测：trace 埋点生成器内建 + OA 机制专属 Log（帧号回溯）
// 变更（2026-10-15 步3）：新建——py 执行器面工具化（design-ch4-pytools §四）

// ── 状态机（3 线——py-run / py-list / py-service）──
§ 'S_Run' = { 'Init', 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_List' = { 'Init', 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }
§ 'S_Svc' = { 'Init', 'Idle', 'Claimed', 'Ready', 'Done', 'Failed' }

// T_Init：启动初始化自述——Init → Idle 首帧写"空闲待命"（R0.2 外观层：启动即有自述横幅）
§ 'T_Init' : 'S_Run' = 'Init' → 'self.desc'["py 空闲待命", "", ""] | 'S_Run' = 'Idle' | 'S_Run' = 'Idle'

// ── 主动传感器壳——3 线探测（纯只读判断积木 → bool 落盒）──
§ 'P_RunOpen' ↻ [1]: 'oa.is_open'["TOOL", "py-run"] > @pyrOpen
§ 'P_ListOpen' ↻ [1]: 'oa.is_open'["TOOL", "py-list"] > @pylOpen
§ 'P_SvcOpen' ↻ [1]: 'oa.is_open'["TOOL", "py-service"] > @pysOpen

// ══════════════ py-run 线（短命脚本执行）══════════════

// T_RunClaim：探测真 + Idle → 原子接单（竞态失败回 Idle 重试）
§ 'T_RunClaim' : @pyrOpen & 'S_Run' = 'Idle' → 'oa.claim_next_simple'["TOOL", "py-run"] > @pyrOffice | 'S_Run' = 'Claimed' | 'S_Run' = 'Idle'

// T_RunArgs：读载荷 args（整包工具参数 JSON——script/args/timeout_ms）+ 执行中自述（par 导线单动作约束——desc 前移）
§ 'T_RunArgs' : 'S_Run' = 'Claimed' → 'oa.get_str'[@pyrOffice, "args"] > @pyrArgs | 'self.desc'["py 脚本执行中", "", ""] | 'S_Run' = 'Ready' | 'S_Run' = 'Failed'

// T_RunExec：执行积木（argsJson 整包——积木内部解析；失败侧 ERR 文本也在 @pyrRes）——后台执行
§ 'T_RunExec' [t=1200, par] : 'S_Run' = 'Ready' → 'py.run'[@pyrArgs] > @pyrRes | 'S_Run' = 'Done' | 'S_Run' = 'Failed'

// T_RunReply：成功回执（result = 结果 JSON）
§ 'T_RunReply' : 'S_Run' = 'Done' → 'oa.complete_str'[@pyrOffice, @pyrRes] | 'self.desc'["py 空闲待命", "", ""] | 'S_Run' = 'Idle' | 'S_Run' = 'Idle'

// T_RunAbort：失败回执（@pyrRes 含 ERR| 文本——失败侧也回执，Dog 可见失败原因）
§ 'T_RunAbort' : 'S_Run' = 'Failed' → 'oa.complete_str'[@pyrOffice, @pyrRes] | 'S_Run' = 'Idle' | 'S_Run' = 'Idle'

// ══════════════ py-list 线（可发现性）══════════════

// T_ListInit：启动初始化自述——Init → Idle 首帧写"空闲待命"
§ 'T_ListInit' : 'S_List' = 'Init' → 'self.desc'["py 空闲待命", "", ""] | 'S_List' = 'Idle' | 'S_List' = 'Idle'

// T_ListClaim：探测真 + Idle → 原子接单
§ 'T_ListClaim' : @pylOpen & 'S_List' = 'Idle' → 'oa.claim_next_simple'["TOOL", "py-list"] > @pylOffice | 'S_List' = 'Claimed' | 'S_List' = 'Idle'

// T_ListArgs：读载荷 args（dir 可选）
§ 'T_ListArgs' : 'S_List' = 'Claimed' → 'oa.get_str'[@pylOffice, "args"] > @pylArgs | 'S_List' = 'Ready' | 'S_List' = 'Failed'

// T_ListExec：执行积木——后台执行
§ 'T_ListExec' [t=1200, par] : 'S_List' = 'Ready' → 'py.list'[@pylArgs] > @pylRes | 'S_List' = 'Done' | 'S_List' = 'Failed'

// T_ListReply：成功回执（result = scripts 数组 JSON）
§ 'T_ListReply' : 'S_List' = 'Done' → 'oa.complete_str'[@pylOffice, @pylRes] | 'S_List' = 'Idle' | 'S_List' = 'Idle'

// T_ListAbort：失败回执
§ 'T_ListAbort' : 'S_List' = 'Failed' → 'oa.complete_str'[@pylOffice, @pylRes] | 'S_List' = 'Idle' | 'S_List' = 'Idle'

// ══════════════ py-service 线（常驻服务启停查）══════════════

// T_SvcInit：启动初始化自述——Init → Idle 首帧写"空闲待命"
§ 'T_SvcInit' : 'S_Svc' = 'Init' → 'self.desc'["py 空闲待命", "", ""] | 'S_Svc' = 'Idle' | 'S_Svc' = 'Idle'

// T_SvcClaim：探测真 + Idle → 原子接单
§ 'T_SvcClaim' : @pysOpen & 'S_Svc' = 'Idle' → 'oa.claim_next_simple'["TOOL", "py-service"] > @pysOffice | 'S_Svc' = 'Claimed' | 'S_Svc' = 'Idle'

// T_SvcArgs：读载荷 args（name/action）+ 执行中自述
§ 'T_SvcArgs' : 'S_Svc' = 'Claimed' → 'oa.get_str'[@pysOffice, "args"] > @pysArgs | 'self.desc'["py 服务操作中", "", ""] | 'S_Svc' = 'Ready' | 'S_Svc' = 'Failed'

// T_SvcExec：执行积木（start 含就绪握手——冷启动可能数秒）——后台执行
§ 'T_SvcExec' [t=1200, par] : 'S_Svc' = 'Ready' → 'py.service'[@pysArgs] > @pysRes | 'S_Svc' = 'Done' | 'S_Svc' = 'Failed'

// T_SvcReply：成功回执（result = 服务态 JSON）
§ 'T_SvcReply' : 'S_Svc' = 'Done' → 'oa.complete_str'[@pysOffice, @pysRes] | 'self.desc'["py 空闲待命", "", ""] | 'S_Svc' = 'Idle' | 'S_Svc' = 'Idle'

// T_SvcAbort：失败回执
§ 'T_SvcAbort' : 'S_Svc' = 'Failed' → 'oa.complete_str'[@pysOffice, @pysRes] | 'S_Svc' = 'Idle' | 'S_Svc' = 'Idle'
