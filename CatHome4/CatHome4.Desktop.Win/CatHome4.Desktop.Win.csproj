<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- 非 Windows 构建机上允许交叉编译（Linux 侧全量 build / test 需要它；WinForms 运行时不在 Linux，产物只编不跑） -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 产物名与历史部署链一致（public/app/CatHome4.exe）——P4 收口常量时再统一 -->
    <AssemblyName>CatHome4</AssemblyName>
    <RootNamespace>CH4</RootNamespace>
    <!-- 应用图标——多尺寸猫爪印 ICO（16/24/32/48/64/128/256，生成器 CatTemp/icongen 一次性产出）；
         嵌入后 exe 文件 / 任务栏 / 窗体标题栏 / 托盘四处同源（托盘与窗体经 Environment.ProcessPath 提取） -->
    <ApplicationIcon>..\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 出口二：桌面外壳（design-ch4-platform §一）——内核下沉 Host，本工程只承载 GUI / 托盘 / AUMID -->
    <ProjectReference Include="..\CatHome4.Host\CatHome4.Host.csproj" />
    <ProjectReference Include="..\CatHome4.Contracts\CatHome4.Contracts.csproj" />
    <ProjectReference Include="..\CatHome4.Admin\CatHome4.Admin.csproj" />
    <ProjectReference Include="..\CatHome4.Platform\CatHome4.Platform.csproj" />
    <ProjectReference Include="..\..\Mau\Mau.Runtime\Mau.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 外观层静态页——复制到输出目录（HttpHost.ServeIndex 从 AppContext.BaseDirectory/html/ 读取）
         排除 tests/node_modules（巨大；测试服务从源码区启动——node_modules 在源码区）
         🔴 publish 面用 Always（G 方案 2026-09-23）：PreserveNewest 的时间戳判据会被「手工写目标」造成的
         mtime 倒挂永久锁死（源比目标旧 → 永不复制 → 产物区冻结 → deploy 静默推旧版）；
         build 面保留 PreserveNewest（日常构建不做全量复制，含 pet 素材 ~8MB） -->
    <None Include="..\html\**" Exclude="..\html\tests\node_modules\**" Link="html\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
