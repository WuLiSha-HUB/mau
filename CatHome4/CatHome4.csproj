<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 出口一：headless 常驻（design-ch4-platform §一）——Linux 生产形态 / Windows 服务形态；
         桌面形态走 CatHome4.Desktop.Win（WinExe）。两条出口共用 CatHome4.Host 内核。 -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CH4</RootNamespace>
    <!-- 域子项目与出口目录排除——SDK 默认递归编译会包含子项目源码（CS0579 特性重复），必须显式排除 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);CatHome4.Contracts\**;CatHome4.Core\**;CatHome4.Http\**;CatHome4.Admin\**;CatHome4.Observe\**;CatHome4.Core.Tests\**;CatHome4.Host\**;CatHome4.Desktop.Win\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="CatHome4.Host\CatHome4.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- P6 外观层静态页——复制到输出目录（HttpHost.ServeIndex 从 AppContext.BaseDirectory/html/ 读取）
         排除 tests/node_modules（巨大；测试服务从源码区启动——node_modules 在源码区）
         🔴 publish 面用 Always（G 方案 2026-09-23）：PreserveNewest 的时间戳判据会被「手工写目标」造成的
         mtime 倒挂永久锁死（源比目标旧 → 永不复制 → 产物区冻结 → deploy 静默推旧版）；
         build 面保留 PreserveNewest（日常构建不做全量复制，含 pet 素材 ~8MB） -->
    <None Include="html\**" Exclude="html\tests\node_modules\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
