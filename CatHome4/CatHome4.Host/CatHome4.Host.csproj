<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CH4</RootNamespace>
    <!-- 域子项目目录排除——SDK 默认递归编译会包含子项目源码（CS0579 特性重复），必须显式排除 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);CatHome4.Contracts\**;CatHome4.Core\**;CatHome4.Http\**;CatHome4.Admin\**;CatHome4.Observe\**;CatHome4.Core.Tests\**;CatHome4.Desktop.Win\**;CatHome4.Platform\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Mau\Mau.Runtime\Mau.Runtime.csproj" />
    <ProjectReference Include="..\..\Mau\Mau.Providers\Mau.Providers.csproj" />
    <!-- B3 mau.* 工具实装——组翻译共享服务（MauProjFile/MauGroupBuilder）自 Mau.Development 引用 -->
    <ProjectReference Include="..\..\Mau\Mau.Development\Mau.Development.csproj" />
    <!-- CH4 域程序集——内核托管层（design-ch4-platform §一） -->
    <ProjectReference Include="..\CatHome4.Contracts\CatHome4.Contracts.csproj" />
    <ProjectReference Include="..\CatHome4.Core\CatHome4.Core.csproj" />
    <ProjectReference Include="..\CatHome4.Http\CatHome4.Http.csproj" />
    <ProjectReference Include="..\CatHome4.Admin\CatHome4.Admin.csproj" />
    <ProjectReference Include="..\CatHome4.Observe\CatHome4.Observe.csproj" />
    <ProjectReference Include="..\CatHome4.Platform\CatHome4.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- P6 外观层 HTTP——Kestrel + Minimal API（FrameworkReference = 运行时自带，非第三方 NuGet 依赖） -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
